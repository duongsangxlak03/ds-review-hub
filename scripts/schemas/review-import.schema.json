{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "affiliate_url",
          "resolved_url",
          "store_name",
          "store_slug",
          "store_category",
          "store_description",
          "store_logo_url",
          "title",
          "h1",
          "slug",
          "meta_title",
          "meta_description",
          "dek",
          "summary",
          "verdict",
          "best_for",
          "pros",
          "cons",
          "content_sections",
          "faqs",
          "hero_image_url",
          "hero_image_alt",
          "sources",
          "research_queries",
          "title_candidates",
          "checked_at"
        ],
        "properties": {
          "affiliate_url": { "type": "string", "minLength": 8 },
          "resolved_url": { "type": "string" },
          "store_name": { "type": "string", "minLength": 2 },
          "store_slug": { "type": "string", "minLength": 2 },
          "store_category": { "type": "string", "minLength": 2 },
          "store_description": { "type": "string" },
          "store_logo_url": { "type": "string" },
          "title": { "type": "string", "minLength": 10 },
          "h1": { "type": "string", "minLength": 10 },
          "slug": { "type": "string", "minLength": 5 },
          "meta_title": { "type": "string", "minLength": 10, "maxLength": 62 },
          "meta_description": { "type": "string", "minLength": 80, "maxLength": 155 },
          "dek": { "type": "string", "minLength": 40, "maxLength": 260 },
          "summary": { "type": "string", "minLength": 100, "maxLength": 900 },
          "verdict": { "type": "string", "minLength": 100, "maxLength": 900 },
          "best_for": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 3 } },
          "pros": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 8 } },
          "cons": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "type": "string", "minLength": 8 } },
          "content_sections": {
            "type": "array",
            "minItems": 4,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "body"],
              "properties": {
                "heading": { "type": "string", "minLength": 5 },
                "body": { "type": "string", "minLength": 100 }
              }
            }
          },
          "faqs": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["question", "answer"],
              "properties": {
                "question": { "type": "string", "minLength": 8 },
                "answer": { "type": "string", "minLength": 40 }
              }
            }
          },
          "hero_image_url": { "type": "string" },
          "hero_image_alt": { "type": "string", "minLength": 5 },
          "sources": {
            "type": "array",
            "minItems": 3,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url", "note"],
              "properties": {
                "label": { "type": "string", "minLength": 2 },
                "url": { "type": "string", "minLength": 8 },
                "note": { "type": "string", "minLength": 20 }
              }
            }
          },
          "research_queries": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "type": "string", "minLength": 4 } },
          "title_candidates": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "string", "minLength": 10 } },
          "checked_at": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
